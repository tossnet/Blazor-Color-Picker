@page "/"
@using BlazorColorPicker

@inject IColorPickerService ColorPickerService

<a href="https://www.nuget.org/packages/BlazorColorPicker/"><img src="https://img.shields.io/nuget/v/BlazorColorPicker.svg" /></a>
<br />

<button class="btn btn-secondary" @onclick="@OpenModal">
    <div style="background-color:@color" class="buttonColor"></div> Select a default Color
</button>

<h2>Usage</h2>

<CodeBlock Language="CodeLanguage.Razor"
		   Code=@(@"
@using BlazorColorPicker

@inject IColorPickerService ColorPickerService

<button @onclick=""OpenModal"">
    <div style=""background-color:@color"" class=""buttonColor""></div> Select a Color
</button>
		   	 	 ") />

<CodeBlock Language="CodeLanguage.CSharp"
		   Code=@(@"
private async Task OpenModal()
{
	var parameters = new ColorPickerParameters
	{
	ColorSelected = color,
	};

    color = await ColorPickerService.ShowColorPicker(parameters);
}
		   	 	 ") />


<div class="mt-4">
	<h5>Use  your own color palette</h5>
	<button class="btn btn-primary" @onclick="OpenModalCustom">
		<div style="background-color:@customColor" class="buttonColor"></div> Select a custom Colors
	</button>
</div>

<div class="mt-4">
	<h5>Change the size</h5>
	<button class="btn btn-primary" @onclick="OpenModalCustomSizes">
		<div style="background-color:@customColorSize" class="buttonColor"></div> Custom sizes
	</button>
</div>

<div class="mt-4">
	<h5>Find the closest color</h5>
	<button class="btn btn-primary" @onclick="OpenModalUnmatched">
		<div style="background-color:@unmatchedColor" class="buttonColor"></div> Select a unmatched Color
	</button>
</div>

<div class="mt-4">
	<h5>Adjust intensity &amp; hue</h5>
	<p class="mb-2">
		<small>
			With <b>Remember the state</b>, the cell and slider positions are stored as JSON, so the palette reopens exactly as it was left.
			Without it, only the hex color is stored: when the palette reopens, it looks for a cell and slider positions that give this color back (<code>PaletteChoice.FromHex</code>).
			The color is the same, but the check mark and sliders may be in a different place, and for a few rare colors nothing is found (no check mark, sliders at neutral).
		</small>
	</p>
	<div class="mb-2">
		<div class="form-check form-check-inline">
			<input class="form-check-input" type="checkbox" id="showIntensity" @bind="showIntensitySlider" />
			<label class="form-check-label" for="showIntensity">Intensity slider</label>
		</div>
		<div class="form-check form-check-inline">
			<input class="form-check-input" type="checkbox" id="showHue" @bind="showHueSlider" />
			<label class="form-check-label" for="showHue">Hue slider</label>
		</div>
		<div class="form-check form-check-inline">
			<input class="form-check-input" type="checkbox" id="rememberState" @bind="rememberState" @bind:after="OnRememberStateChanged" />
			<label class="form-check-label" for="rememberState">Remember the state (otherwise the hex only)</label>
		</div>
	</div>
	<button class="btn btn-primary" @onclick="OpenModalAdjust">
		<div style="background-color:@adjustColor" class="buttonColor"></div> Select an adjusted Color
	</button>
	<div class="mt-1"><small>Stored color: <code>@adjustColor</code> &mdash; Stored state: <code>@(rememberState ? adjustState ?? "(none)" : "(not remembered)")</code></small></div>
</div>

<CodeBlock Language="CodeLanguage.CSharp"
		   Code=@(@"
private string color = ""#2196F3"";
private string? state; // JSON stored with the setting

private async Task OpenModalAdjust()
{
	var parameters = new ColorPickerParameters
	{
		ColorSelected = color,
		ShowIntensitySlider = true,
		ShowHueSlider = true,
		PaletteChoice = PaletteChoice.Resolve(state, color),
	};

	var choice = await ColorPickerService.ShowPaletteChoice(parameters);
	if (choice is not null)
	{
		color = choice.Hex;
		state = choice.ToJson();
	}
}
		   	 	 ") />

@code {
	private string adjustColor = "#2196F3";
	private string? adjustState;
	private bool showIntensitySlider = true;
	private bool showHueSlider = true;
	private bool rememberState = true;

	private void OnRememberStateChanged()
	{
		// Without memorization, only the hex is kept: the palette deduces the sliders with FromHex
		if (!rememberState)
			adjustState = null;
	}

	private async Task OpenModalAdjust()
	{
		var parameters = new ColorPickerParameters
		{
			ColorSelected = adjustColor,
			ShowIntensitySlider = showIntensitySlider,
			ShowHueSlider = showHueSlider,
			PaletteChoice = rememberState ? PaletteChoice.Resolve(adjustState, adjustColor) : null,
		};

		var choice = await ColorPickerService.ShowPaletteChoice(parameters);
		if (choice is not null)
		{
			adjustColor = choice.Hex;
			adjustState = rememberState ? choice.ToJson() : null;
		}
	}

	private string color = "#ec407a";
	private string customColor = "#FFFFFF";
	private string customColorSize = "#42A5F6";
	private string unmatchedColor = "#8B4513";

	private async Task OpenModal()
	{
		var parameters = new ColorPickerParameters
		{
			ColorSelected = color,
		};
		color = await ColorPickerService.ShowColorPicker(parameters);
	}

	private async Task OpenModalCustom()
	{
		string[] colors = new string[] { 
			"#F44336", "#E91E63", "#9C27B0", "#673AB7", 
			"#3F51B5", "#2196F3", "#03A9F4", "#00BCD4", 
			"#009688", "#4CAF50", "#8BC34A", "#CDDC39", 
			"#FFEB3B", "#FFC107", "#FF9800", "#FF5722",
			"#795548", "#9E9E9E", "#607D8B", "#000000",
			"#FFFFFF", "#ECEFF1", "#CFD8DC", "#B0BEC5"
		};

		var parameters = new ColorPickerParameters
		{
			ColorSelected = customColor,
			MyColorPallet = colors,
			OverwriteBackgroundColor = "#CCCCCC",
			Title = "Custom Colors",
		};
		customColor = await ColorPickerService.ShowColorPicker(parameters);
    }

	private async Task OpenModalCustomSizes()
	{
		var parameters = new ColorPickerParameters
		{
			ColorSelected = customColorSize,
			Style = "width: 304px; height: 304px",
		};
		customColorSize = await ColorPickerService.ShowColorPicker(parameters);
	}

	private async Task OpenModalUnmatched()
	{
		var parameters = new ColorPickerParameters
		{
			ColorSelected = unmatchedColor,
			FindClosestIfNotFound = true,
		};
		unmatchedColor = await ColorPickerService.ShowColorPicker(parameters);
	}
}
