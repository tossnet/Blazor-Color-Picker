<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <RootNamespace>BlazorColorPicker</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Package metadata -->
    <PackageId>BlazorColorPicker</PackageId>
    <Version>4.5.1</Version>
    <Authors>Christophe Peugnet</Authors>
    <Copyright>Copyright 2020-2026</Copyright>
    <Description>Opens a modal palette with the Material colors for Blazor Application</Description>
    <PackageTags>blazor;color;picker;material;component</PackageTags>
    <PackageProjectUrl>https://github.com/tossnet/Blazor-Color-Picker</PackageProjectUrl>
    <RepositoryUrl>https://github.com/tossnet/Blazor-Color-Picker.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes>
      4.5.1: republish of 4.5.0, whose package mistakenly contained the 4.4 binaries.
      Optional Intensity and Hue sliders (ShowIntensitySlider, ShowHueSlider) on the Material palette, PaletteChoice state (ShowPaletteChoice, FromHex, JSON) to restore the palette exactly. IColorPickerService gains ShowPaletteChoice.
    </PackageReleaseNotes>

    <!-- Build and symbols -->
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <AssemblyVersion>4.0.0.0</AssemblyVersion>
    <FileVersion>4.0.0.0</FileVersion>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BlazorColorPicker.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="nuget.exe" />
    <None Include="icon.png" Pack="true" PackagePath="" />
    <None Include="..\README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="8.0.34" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="9.0.23" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="wwwroot\colorpicker.css">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
