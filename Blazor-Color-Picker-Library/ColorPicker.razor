@if (IsVisible)
{
	<div @ref="Element"
		 class="color-picker-modal @CssClass"
		 style="@ModalStyle"
		 tabindex="0"
		 @onkeydown="@KeyDown" >
		<div class="color-picker-content">
			@if (!string.IsNullOrEmpty(Parameters.Title))
			{
				<div class="color-picker-header">
					<h5 class="color-picker-title">@Parameters.Title</h5>
					<span class="color-picker-close-button" @onclick="HandleCancel">X</span>
				</div>
			}
			@if (IsAdjustMode)
			{
				<div class="@AdjustCssClass">
					@Palette
					@if (Parameters.ShowIntensitySlider)
					{
						<div class="color-picker-slider-wrap color-picker-slider-wrap-vertical">
							<input type="range"
								   class="color-picker-slider color-picker-slider-vertical"
								   aria-label="Intensity"
								   title="Intensity"
								   min="@PaletteChoice.MinIntensity" max="@PaletteChoice.MaxIntensity" step="1"
								   style="--color-picker-track: @_intensityTrack"
								   @bind:get="_intensity" @bind:set="SetIntensity" @bind:event="oninput"
								   @onkeydown="SliderKeyDown"
								   @onpointerdown="SliderPointerDown" />
						</div>
					}
					@if (Parameters.ShowHueSlider)
					{
						<div class="color-picker-slider-wrap color-picker-slider-wrap-horizontal">
							<input type="range"
								   class="color-picker-slider color-picker-slider-horizontal"
								   aria-label="Hue"
								   title="Hue"
								   min="@PaletteChoice.MinHue" max="@PaletteChoice.MaxHue" step="1"
								   style="--color-picker-track: @_hueTrack"
								   @bind:get="_hue" @bind:set="SetHue" @bind:event="oninput"
								   @onkeydown="SliderKeyDown"
								   @onpointerdown="SliderPointerDown" />
						</div>
					}
				</div>
			}
			else
			{
				@Palette
			}
		</div>
	</div>
}

@code {
	private RenderFragment Palette => __builder =>
	{
		<div class="color-picker-body" style="@PaletteStyle @Parameters.Style">
			<div class="color-picker-palette" style="@CustomStyle">
				@for (var i = 0; i < colors.Count; i++)
				{
					var index = i;
					var item = colors[index];
					<div class="color-picker-case text-center"
						 style="background-color:@item"
						 @onclick="() => ColorClick(index)">
						@if (IsColorHighlighted(index, item))
						{
							<svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" viewBox="0 0 24 24"><path d="M20.285 2l-11.285 11.567-5.286-5.011-3.714 3.716 9 8.728 15-15.285z" /></svg>
						}
					</div>
				}
			</div>
		</div>
	};
}
